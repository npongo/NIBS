[project]
name = "nibs"
version = "0.1.0"
description = "python environment required to access the data for the NIBS project"
readme = "README.md"
requires-python = ">=3.13"
dependencies = ['numpy','ipykernel','scipy','polars','pyarrow','pandas','requests', 'geopandas','patchworklib>=0.6.5','plotnine','duckdb','pillow']

[tool.uv.workspace]
members = [".venv/Scripts"]
